# Wrangler's generated binding declarations preserve upstream whitespace.
# Keep the generated bytes exact while excluding those files from whitespace diagnostics.
apps/web/worker-configuration.d.ts whitespace=-trailing-space
workers/api/worker-configuration.d.ts whitespace=-trailing-space
workers/mail/worker-configuration.d.ts whitespace=-trailing-space
packages/db/migrations/*.sql text eol=lf
