{
  "name": "cloudflare-inbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check && node tooling/scripts/check-boundaries.mjs",
    "check:boundaries": "node tooling/scripts/check-boundaries.mjs",
    "check:generated": "node tooling/scripts/check-generated.mjs",
    "dev": "vp run -r --parallel dev",
    "typegen": "vp run -r cf-typegen",
    "test": "vp test",
    "test:worker": "vp run -r test:worker",
    "test:integration": "vp run -r test:integration",
    "test:e2e": "vp run -r test:e2e",
    "test:boundaries": "node --test tooling/scripts/check-boundaries.test.mjs",
    "test:operator": "vp test run tests/operator/operator.test.mjs",
    "db:generate": "vp run @cloudflare-inbox/db#db:generate",
    "db:migrate": "node tooling/scripts/migrate.mjs",
    "provision": "node tooling/scripts/provision.mjs",
    "bootstrap": "node tooling/scripts/bootstrap.mjs",
    "api-token:create": "node tooling/scripts/api-token.mjs create",
    "api-token:list": "node tooling/scripts/api-token.mjs list",
    "api-token:revoke": "node tooling/scripts/api-token.mjs revoke",
    "deploy:mail": "node tooling/scripts/deploy-worker.mjs mail",
    "deploy:api": "node tooling/scripts/deploy-worker.mjs api",
    "deploy:web": "node tooling/scripts/deploy-worker.mjs web",
    "smoke": "node tooling/scripts/smoke.mjs",
    "smoke:live": "node tooling/scripts/live-smoke.mjs",
    "deploy": "node tooling/scripts/deploy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.18.0"
  },
  "packageManager": "pnpm@11.18.0"
}
