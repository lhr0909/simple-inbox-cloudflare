{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "simple-inbox-cf-local-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "services": [
    {
      "binding": "MAIL",
      "service": "simple-inbox-cf-local-mail",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simple-inbox-cf-local-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "RAW_EMAILS",
      "bucket_name": "simple-inbox-cf-local-raw",
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:3000",
    "MAIL_DOMAIN": "example.test",
    "OWNER_EMAIL": "owner@example.test",
    "ENVIRONMENT": "local",
    "RAW_EMAIL_RETENTION_DAYS": "365",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
  "env": {
    "staging": {
      "name": "simple-inbox-cf-staging-api",
      "workers_dev": false,
      "services": [
        {
          "binding": "MAIL",
          "service": "simple-inbox-cf-staging-mail",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "simple-inbox-cf-staging-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "RAW_EMAILS",
          "bucket_name": "simple-inbox-cf-staging-raw",
        },
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMIT",
          "namespace_id": "2001",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "vars": {
        "APP_ORIGIN": "https://inbox-staging.example.test",
        "MAIL_DOMAIN": "mail-staging.example.test",
        "OWNER_EMAIL": "owner@example.test",
        "ENVIRONMENT": "staging",
        "RAW_EMAIL_RETENTION_DAYS": "365",
      },
    },
    "production": {
      "name": "simple-inbox-cf-production-api",
      "workers_dev": false,
      "services": [
        {
          "binding": "MAIL",
          "service": "simple-inbox-cf-production-mail",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "simple-inbox-cf-production-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "RAW_EMAILS",
          "bucket_name": "simple-inbox-cf-production-raw",
        },
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMIT",
          "namespace_id": "3001",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "vars": {
        "APP_ORIGIN": "https://inbox.example.test",
        "MAIL_DOMAIN": "mail.example.test",
        "OWNER_EMAIL": "owner@example.test",
        "ENVIRONMENT": "production",
        "RAW_EMAIL_RETENTION_DAYS": "365",
      },
    },
  },
}
