{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simple-inbox-cf-local-web",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "services": [
    {
      "binding": "API",
      "service": "simple-inbox-cf-local-api",
    },
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:3000",
    "ENVIRONMENT": "local",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
  "env": {
    "staging": {
      "name": "simple-inbox-cf-staging-web",
      "workers_dev": true,
      "services": [
        {
          "binding": "API",
          "service": "simple-inbox-cf-staging-api",
        },
      ],
      "vars": {
        "APP_ORIGIN": "https://inbox-staging.example.test",
        "ENVIRONMENT": "staging",
      },
    },
    "production": {
      "name": "simple-inbox-cf-production-web",
      "workers_dev": true,
      "services": [
        {
          "binding": "API",
          "service": "simple-inbox-cf-production-api",
        },
      ],
      "vars": {
        "APP_ORIGIN": "https://inbox.example.test",
        "ENVIRONMENT": "production",
      },
    },
  },
}
